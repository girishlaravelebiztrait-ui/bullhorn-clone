# --- Database (MySQL) ---
# Matches the docker-compose service. Host port is 3307 (mapped to the
# container's 3306) to avoid clashing with any MySQL already on 3306.
DATABASE_URL="mysql://ats:ats_password@localhost:3307/ats"

# --- Elasticsearch ---
ELASTICSEARCH_URL="http://localhost:9200"
# Optional if you enable security on ES (single-node dev has it disabled):
# ELASTICSEARCH_USERNAME="elastic"
# ELASTICSEARCH_PASSWORD="changeme"

# --- NextAuth ---
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed admin (used by scripts/seed.ts) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Admin"

# --- File storage ---
# "local" is the only implemented driver in phase 1. Structured to swap to "s3" later.
STORAGE_DRIVER="local"
# Where resume files are written when STORAGE_DRIVER=local (relative to project root).
UPLOAD_DIR="uploads"
